{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "cursor"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide"
  },
  "animations": true,
  "tabs": {
    "mode": "on"
  },
  "keybinds": {
    "session.tab.previous": "alt+down",
    "session.tab.next": "alt+up",
    "input.word.backward": "alt+b,ctrl+left",
    "input.word.forward": "alt+f,ctrl+right"
  }
}
