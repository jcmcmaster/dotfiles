{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "csharp": {
      "command": [
        "Microsoft.CodeAnalysis.LanguageServer",
        "--stdio",
        "--autoLoadProjects"
      ],
      "extensions": [
        "*.cs",
        "*.csproj",
        "*.fs",
        "*.fsproj"
      ]
    }
  }
}
